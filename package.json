{
  "name": "mzcell-rentabilidade",
  "version": "1.2.0",
  "description": "MZCell — Painel de Rentabilidade Mercado Livre",
  "main": "index.js",
  "author": "Felipe Mfranca",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.mzcell.rentabilidade",
    "productName": "MZCell Rentabilidade",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "../",
        "to": ".",
        "filter": [
          "main.py",
          "sync_service.py",
          "sync_produto.py",
          "ml_api.py",
          "parser_rentabilidade.py",
          "refresh_ml_token.py",
          "ranking_ml.py",
          "dashboard.html",
          "config.json",
          "produtos.json",
          "anotacoes.json",
          "usuarios.json",
          "sync_status.json",
          "log_atividades.json",
          "auth_service.py",
          "email_config.json",
          "python-embed/**",
          "version.txt"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Felipe-Mfranca",
      "repo": "-mzcell-rentabilidade-"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}