{
  "name": "mzcell-rentabilidade",
  "version": "1.3.13",
  "description": "MZ App — Painel de Rentabilidade Mercado Livre",
  "main": "index.js",
  "author": "Felipe Mfranca",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.mzcell.rentabilidade",
    "productName": "MZ App",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "main.py",
          "sync_service.py",
          "sync_produto.py",
          "produtos_store.py",
          "ml_api.py",
          "parser_rentabilidade.py",
          "refresh_ml_token.py",
          "ranking_ml.py",
          "dashboard.html",
          "config.json",
          "produtos.json",
          "usuarios.json",
          "sync_status.json",
          "log_atividades.json",
          "auth_service.py",
          "reposicao_full.py",
          "cmv_base.py",
          "pivo_ml.py",
          "full_alerta.py",
          "shared_store.py",
          "rebot_agenda.py",
          "rebot_visual.py",
          "buybox_monitor.py",
          "marketplaces/**",
          "!marketplaces/**/__pycache__/**",
          "!marketplaces/shopee/*.zip",
          "shared_config.json",
          "cmv_base.json",
          "amazon_config.json",
          "amazon_custos.json",
          "anotacoes.json",
          "posicoes.json",
          "impostos.json",
          "impostos.py",
          "email_config.json",
          "python-embed/**",
          "version.txt"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Felipe-Mfranca",
      "repo": "-mzcell-rentabilidade-"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}